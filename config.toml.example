[bookings]
max_upcoming_bookings = 6

[admin]
# User IDs (from the OAuth provider) that should have admin access.
user_ids = [1]

# --- Fake telescopes (useful for development / testing) ---

[[telescopes]]
name = "fake1"
location = [ 11.9188, 57.3934 ]  # [longitude, latitude] in degrees
min_elevation = 5.0    # in degrees
max_elevation = 175.0  # in degrees
stow_position = [ 90.0, 90.0 ]  # [azimuth, elevation] in degrees
service_position = [ 0.0, 5.0 ]  # [azimuth, elevation] in degrees; elevation should match min_elevation
telescope_type = "Fake"

[[telescopes]]
name = "fake2"
location = [ 11.9188, 57.3934 ]  # [longitude, latitude] in degrees
min_elevation = 5.0    # in degrees
max_elevation = 175.0  # in degrees
stow_position = [ 90.0, 90.0 ]  # [azimuth, elevation] in degrees
service_position = [ 70.0, 5.0 ]  # [azimuth, elevation] in degrees; elevation should match min_elevation
telescope_type = "Fake"

# --- Real SALSA telescopes ---
#
# webcam_crop = [x, y, w, h]  — fractions of the full webcam image (top-left origin).
# Crops the webcam snapshot to the telescope's position and displays it on the observe page.
# Omit or comment out to disable the webcam panel for that telescope.
#
# x and w are fractions of the frame width; y and h are fractions of the 32:9
# viewport height (width * 9/32), measured from the top of the frame. The values
# below were measured on the camera installed 2026-08-05 and are not valid for
# any earlier one — re-measure after the camera is moved or replaced.

# [[telescopes]]
# name = "torre"
# location = [ 11.9188, 57.3934 ]  # [longitude, latitude] in degrees
# min_elevation = 5.0    # in degrees
# max_elevation = 175.0  # in degrees
# webcam_crop = [ 0.1513, 0.8241, 0.0677, 0.2778 ]  # [x, y, w, h] fractions, top-left origin
# stow_position = [ 90.0, 90.0 ]  # [azimuth, elevation] in degrees
# service_position = [ 0.0, 5.0 ]  # [azimuth, elevation] in degrees; elevation should match min_elevation
# telescope_type = "Salsa"
# controller_address = "192.168.5.11:23"
# receiver_address = "192.168.5.31"
# default_ref_freq_mhz = 1417.9
# default_gain_db = 60.0
# tsys_k = 300.0  # system temperature in K; scales switched-mode spectra to antenna temperature (Ta)
# wind_warning_ms = 18.0  # warn users if 10-min avg wind exceeds this (m/s); omit to disable
# gpsdo_enabled = true    # use external 10 MHz reference and PPS for clock sync; required for interferometry

